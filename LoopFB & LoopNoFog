local function doMinimize()
    if confirmFrame.Visible or settingsFrame.Visible then return end
    isMinimized = not isMinimized
    if isMinimized then
        TweenService:Create(mainFrame, TweenInfo.new(0.1,Enum.EasingStyle.Quad), {Size=UDim2.new(0,270,0,57)}):Play()
        contentFrame.Visible = false
        footerLabel.Visible = false
        footerLabelMinimized.Visible = true
        minimizeButton.Text = "+"
    else
        TweenService:Create(mainFrame, TweenInfo.new(0.1,Enum.EasingStyle.Quad), {Size=UDim2.new(0,270,0,165)}):Play()
        contentFrame.Visible = true
        footerLabel.Visible = true
        footerLabelMinimized.Visible = false
        minimizeButton.Text = "-"
    end
end

local function hideGUI() isHidden=true mainFrame.Visible=false end
local function showGUI() isHidden=false mainFrame.Visible=true end

local function openConfirm()
    if confirmFrame.Visible or settingsFrame.Visible then return end
    if isMinimized then
        isMinimized = false
        mainFrame.Size = UDim2.new(0,270,0,165)
        contentFrame.Visible = true
        footerLabel.Visible = true
        footerLabelMinimized.Visible = false
        minimizeButton.Text = "-"
    end
    if isHidden then showGUI() end
    confirmFrame.Visible = true
    TweenService:Create(confirmFrame, TweenInfo.new(0.1,Enum.EasingStyle.Quad), {BackgroundTransparency=0.05}):Play()
end

local function toggleFB()
    loopFBActive = not loopFBActive
    if loopFBActive then startFB() else stopFB() end
