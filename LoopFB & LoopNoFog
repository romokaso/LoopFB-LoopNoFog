local function animateButton(button)
    local os = button.Size
    local ti = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local g = TweenService:Create(button, ti, {Size=UDim2.new(os.X.Scale,os.X.Offset+4,os.Y.Scale,os.Y.Offset+4)})
    g:Play()
    g.Completed:Connect(function()
        if button and button.Parent then TweenService:Create(button, ti, {Size=os}):Play() end
    end)
end

local function updateKbText(slot)
    local btn = kbButtons[slot].button
    if keybinds[slot] then
        btn.Text = keybinds[slot].Name
        btn.TextColor3 = Color3.fromRGB(80, 150, 255)
    else
        btn.Text = "None"
        btn.TextColor3 = Color3.fromRGB(150, 150, 170)
    end
end

local function setToggleVisual(btn, stroke, active, offTxt, onTxt)
    local t = TweenInfo.new(0.1, Enum.EasingStyle.Quad)
    if active then
        TweenService:Create(btn, t, {BackgroundColor3=Color3.fromRGB(30,80,180)}):Play()
        TweenService:Create(stroke, t, {Color=Color3.fromRGB(80,150,255)}):Play()
        btn.Text = onTxt
        btn.TextColor3 = Color3.fromRGB(255,255,255)
    else
        local bg = currentTheme=="dark" and Color3.fromRGB(35,35,48) or Color3.fromRGB(215,215,232)
        local tc = currentTheme=="dark" and Color3.fromRGB(200,200,210) or Color3.fromRGB(30,30,40)
        TweenService:Create(btn, t, {BackgroundColor3=bg}):Play()
        TweenService:Create(stroke, t, {Color=Color3.fromRGB(60,60,80)}):Play()
        btn.Text = offTxt
        btn.TextColor3 = tc
    end
end

local function setMainBtnVisual(btn, stroke, active, offTxt, onTxt)
    local t = TweenInfo.new(0.1, Enum.EasingStyle.Quad)
    if active then
        TweenService:Create(btn, t, {BackgroundColor3=Color3.fromRGB(30,80,180)}):Play()
        TweenService:Create(stroke, t, {Color=Color3.fromRGB(80,150,255)}):Play()
        btn.Text = onTxt
        btn.TextColor3 = Color3.fromRGB(255,255,255)
    else
        local bg = currentTheme=="dark" and Color3.fromRGB(35,35,45) or Color3.fromRGB(220,220,235)
        local tc = currentTheme=="dark" and Color3.fromRGB(200,200,210) or Color3.fromRGB(30,30,40)
        TweenService:Create(btn, t, {BackgroundColor3=bg}):Play()
        TweenService:Create(stroke, t, {Color=Color3.fromRGB(60,60,80)}):Play()
        btn.Text = offTxt
