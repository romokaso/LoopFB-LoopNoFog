local defaultLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    ColorShift_Bottom = Lighting.ColorShift_Bottom,
    ColorShift_Top = Lighting.ColorShift_Top,
    EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
    EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    ShadowSoftness = Lighting.ShadowSoftness,
    FogEnd = Lighting.FogEnd,
    FogStart = Lighting.FogStart,
    FogColor = Lighting.FogColor,
}
local defaultAtmosphere = {}
local defaultEffects = {}

for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("Atmosphere") then
        defaultAtmosphere = {Density=v.Density,Offset=v.Offset,Haze=v.Haze,Glare=v.Glare,Decay=v.Decay,Color=v.Color}
    elseif v:IsA("ColorCorrectionEffect") then
        defaultEffects[v] = {Brightness=v.Brightness,Contrast=v.Contrast,Saturation=v.Saturation,TintColor=v.TintColor,Enabled=v.Enabled}
    elseif v:IsA("BlurEffect") then
        defaultEffects[v] = {Size=v.Size,Enabled=v.Enabled}
    elseif v:IsA("SunRaysEffect") then
        defaultEffects[v] = {Intensity=v.Intensity,Enabled=v.Enabled}
    elseif v:IsA("DepthOfFieldEffect") then
        defaultEffects[v] = {Enabled=v.Enabled}
    end
end

local function saveData()
    pcall(function()
        local data = {
            loopFB=loopFBActive,loopNoFog=loopNoFogActive,
            loopFogDensity=loopFogDensityActive,loopTime=loopTimeActive,
            fbBrightness=fbBrightness,fogDensityValue=fogDensityValue,timeValue=timeValue,
            theme=currentTheme,
            kb1=keybinds.kb1 and keybinds.kb1.Name or nil,
            kb2=keybinds.kb2 and keybinds.kb2.Name or nil,
            kb3=keybinds.kb3 and keybinds.kb3.Name or nil,
            kb4=keybinds.kb4 and keybinds.kb4.Name or nil,
            kb5=keybinds.kb5 and keybinds.kb5.Name or nil,
            kb6=keybinds.kb6 and keybinds.kb6.Name or nil,
            kb7=keybinds.kb7 and keybinds.kb7.Name or nil,
        }
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadData()
    local ok, result = pcall(function()
        if isfile(SAVE_FILE) then return HttpService:JSONDecode(readfile(SAVE_FILE)) end
        return nil
    end)
    if ok and result then return result end
    return nil
end

