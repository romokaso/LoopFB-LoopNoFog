    end

    if isDark then
        TweenService:Create(darkStroke, t, {Color=Color3.fromRGB(80,150,255)}):Play()
        local ls = lightButton:FindFirstChild("UIStroke")
        if ls then
            TweenService:Create(ls, t, {Transparency=1}):Play()
            task.delay(0.15, function() if ls and ls.Parent then ls:Destroy() end end)
        end
    else
