local function restoreDefaultLighting()
    Lighting.Brightness = defaultLighting.Brightness
    Lighting.ClockTime = defaultLighting.ClockTime
    Lighting.GlobalShadows = defaultLighting.GlobalShadows
    Lighting.Ambient = defaultLighting.Ambient
    Lighting.OutdoorAmbient = defaultLighting.OutdoorAmbient
    Lighting.ColorShift_Bottom = defaultLighting.ColorShift_Bottom
    Lighting.ColorShift_Top = defaultLighting.ColorShift_Top
    Lighting.EnvironmentDiffuseScale = defaultLighting.EnvironmentDiffuseScale
    Lighting.EnvironmentSpecularScale = defaultLighting.EnvironmentSpecularScale
    Lighting.ShadowSoftness = defaultLighting.ShadowSoftness
    for v, props in pairs(defaultEffects) do
        if v and v.Parent then for k, val in pairs(props) do v[k]=val end end
    end
end

local function restoreDefaultFog()
    Lighting.FogEnd = defaultLighting.FogEnd
    Lighting.FogStart = defaultLighting.FogStart
    Lighting.FogColor = defaultLighting.FogColor
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") and defaultAtmosphere.Density~=nil then
            v.Density=defaultAtmosphere.Density v.Offset=defaultAtmosphere.Offset
            v.Haze=defaultAtmosphere.Haze v.Glare=defaultAtmosphere.Glare
            v.Decay=defaultAtmosphere.Decay v.Color=defaultAtmosphere.Color
        end
    end
end

local function stopFB()
    if fbConnection then fbConnection:Disconnect() fbConnection=nil end
    restoreDefaultLighting()
end

local function stopFog()
    if fogConnection then fogConnection:Disconnect() fogConnection=nil end
    restoreDefaultFog()
end

local function stopFogDensity()
    if fogDensityConnection then fogDensityConnection:Disconnect() fogDensityConnection=nil end
    restoreDefaultFog()
end

local function stopTime()
    if timeConnection then timeConnection:Disconnect() timeConnection=nil end
    Lighting.ClockTime = defaultLighting.ClockTime
end

local function startFB()
    if fbConnection then fbConnection:Disconnect() fbConnection=nil end
    fbConnection = RunService.Heartbeat:Connect(function()
        Lighting.Brightness = fbBrightness
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(255,255,255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        Lighting.ColorShift_Bottom = Color3.fromRGB(0,0,0)
        Lighting.ColorShift_Top = Color3.fromRGB(0,0,0)
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
        Lighting.ShadowSoftness = 0
        if not loopTimeActive then
            Lighting.ClockTime = 14
        end
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("ColorCorrectionEffect") then
                v.Brightness=0 v.Contrast=0 v.Saturation=0 v.TintColor=Color3.fromRGB(255,255,255)
            elseif v:IsA("BlurEffect") then v.Size=0
            elseif v:IsA("SunRaysEffect") then v.Intensity=0
            elseif v:IsA("DepthOfFieldEffect") then v.Enabled=false
            end
        end
    end)
end

local function startFog()
    if fogConnection then fogConnection:Disconnect() fogConnection=nil end
    fogConnection = RunService.Heartbeat:Connect(function()
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9
        Lighting.FogColor = Color3.fromRGB(128,128,128)
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density=0 v.Offset=0 v.Haze=0 v.Glare=0
                v.Decay=Color3.fromRGB(255,255,255)
                v.Color=Color3.fromRGB(255,255,255)
            end
        end
    end)
end

local function startFogDensity()
    if fogDensityConnection then fogDensityConnection:Disconnect() fogDensityConnection=nil end
    fogDensityConnection = RunService.Heartbeat:Connect(function()
        local pct = fogDensityValue/100
        Lighting.FogEnd = 9e9-(9e9-500)*pct
        Lighting.FogStart = 0
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density = math.clamp(pct*0.85,0,0.85)
                v.Haze = math.clamp(pct*2.5,0,2.5)
                v.Glare = math.clamp(1-pct,0,1)
            end
        end
    end)
end

local function startTime()
    if timeConnection then timeConnection:Disconnect() timeConnection=nil end
    timeConnection = RunService.Heartbeat:Connect(function()
        Lighting.ClockTime = timeValue
    end)
end

local function updateFBSlider(pct)
    pct = math.clamp(pct,0,1)
    fbSliderFill.Size = UDim2.new(pct,0,1,0)
    fbSliderKnob.Position = UDim2.new(pct,-8,0.5,-8)
    fbBrightness = 1+pct*9
    fbValLabel.Text = string.format("%.1f",fbBrightness)
end

local function updateFogSlider(pct)
    pct = math.clamp(pct,0,1)
    fogSliderFill.Size = UDim2.new(pct,0,1,0)
    fogSliderKnob.Position = UDim2.new(pct,-8,0.5,-8)
    fogDensityValue = math.floor(pct*100)
    fogValLabel.Text = fogDensityValue.."%"
    if loopFogDensityActive then startFogDensity() end
end

local function updateTimeSlider(pct)
    pct = math.clamp(pct,0,1)
    timeSliderFill.Size = UDim2.new(pct,0,1,0)
    timeSliderKnob.Position = UDim2.new(pct,-8,0.5,-8)
    timeValue = pct*24
    local h = math.floor(timeValue)
    local m = math.floor((timeValue-h)*60)
    timeValLabel.Text = string.format("%02d:%02d",h,m)
    if loopTimeActive then startTime() end
end

local function processSlider(bgRef, inputX, cb)
    local bx = bgRef.AbsolutePosition.X
    local bw = bgRef.AbsoluteSize.X
    if bw<=0 then return end
    cb(math.clamp((inputX-bx)/bw,0,1))
end

local sliderDefs = {
    {bg=fbSliderBg, knob=fbSliderKnob, cb=function(p) updateFBSlider(p) saveData() end},
    {bg=fogSliderBg, knob=fogSliderKnob, cb=function(p) updateFogSlider(p) saveData() end},
    {bg=timeSliderBg, knob=timeSliderKnob, cb=function(p) updateTimeSlider(p) saveData() end},
}

