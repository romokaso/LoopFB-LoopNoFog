    end
    for _, sep in ipairs(allSeps) do
        TweenService:Create(sep, t, {TextColor3=sepC}):Play()
    end
    for _, vl in ipairs(allValLabels) do
        TweenService:Create(vl, t, {TextColor3=Color3.fromRGB(80,150,255)}):Play()
    end
    for _, kd in ipairs(kbData) do
