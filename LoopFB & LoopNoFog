    local mainBtnTc = isDark and Color3.fromRGB(200,200,210) or Color3.fromRGB(30,30,40)

    for _, f in ipairs({mainFrame,contentFrame,settingsFrame}) do
        TweenService:Create(f, t, {BackgroundColor3=mainBg}):Play()
    end
    TweenService:Create(mainStroke, t, {Color=strokeC}):Play()
    for _, f in ipairs({titleBar,titleFix,settingsTitleBar,settingsTitleFix}) do
        TweenService:Create(f, t, {BackgroundColor3=topBg}):Play()
    end
    TweenService:Create(titleLabel, t, {TextColor3=textC}):Play()
    TweenService:Create(settingsTitleLabel, t, {TextColor3=textC}):Play()
    TweenService:Create(footerLabel, t, {TextColor3=footerC}):Play()
    TweenService:Create(footerLabelMinimized, t, {TextColor3=footerC}):Play()
    TweenService:Create(confirmFrame, t, {BackgroundColor3=isDark and Color3.fromRGB(15,15,20) or Color3.fromRGB(240,240,250)}):Play()
    TweenService:Create(confirmText, t, {TextColor3=textC}):Play()
    TweenService:Create(settingsButtonTop, t, {BackgroundColor3=isDark and Color3.fromRGB(100,100,120) or Color3.fromRGB(200,200,220),TextColor3=textC}):Play()

