titleBar.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState==Enum.UserInputState.End then isDragging=false end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input==dragInput and isDragging then
        local delta = input.Position-dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
    if sliderDragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
        processSlider(sliderDragging.bg, input.Position.X, sliderDragging.cb)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        sliderDragging = nil
        isDragging = false
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType~=Enum.UserInputType.Keyboard then return end
    if listeningSlot~=nil then
        local slot = listeningSlot
        listeningSlot = nil
        keybinds[slot] = input.KeyCode
        updateKbText(slot)
        saveData()
        return
    end
    if gpe then return end
    if keybinds.kb1 and input.KeyCode==keybinds.kb1 then toggleFB()
    elseif keybinds.kb2 and input.KeyCode==keybinds.kb2 then toggleNoFog()
    elseif keybinds.kb3 and input.KeyCode==keybinds.kb3 then
        if isHidden then showGUI() else hideGUI() end
    elseif keybinds.kb4 and input.KeyCode==keybinds.kb4 then doMinimize()
    elseif keybinds.kb5 and input.KeyCode==keybinds.kb5 then openConfirm()
    elseif keybinds.kb6 and input.KeyCode==keybinds.kb6 then toggleFogDensity()
    elseif keybinds.kb7 and input.KeyCode==keybinds.kb7 then toggleTime()
    end
end)

